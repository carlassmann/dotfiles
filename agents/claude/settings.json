{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "disableRemoteControl": true,
  "disableClaudeAiConnectors": true,
  "disableArtifact": true,
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "allow": [
      "Bash(codex:*)",
      "Bash(opencode:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "autoCompactWindow": 1000000,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "25"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] && bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/carlassmann/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Brezeling",
      "Zapfing",
      "Tramming",
      "Eisbaching",
      "Maßing",
      "Weißwursting",
      "Obatzing",
      "Radlering",
      "Schweinsbrating",
      "Leberkäsing",
      "Schmankerling",
      "Biergartening",
      "Hofbräuing",
      "Augustinering",
      "Paulanering",
      "Wiesning",
      "Oktoberfesting",
      "Lederhosing",
      "Dirndling",
      "Schuhplattling",
      "Glockenspieling",
      "Marienplatzing",
      "Viktualienmarkting",
      "Schwabinging",
      "Giesinging",
      "Sendlinging",
      "Haidhausing",
      "Pasinging",
      "Stachusing",
      "Frauenkirching",
      "Olympiaparking",
      "Englischgartening",
      "Kaiserschmarrning",
      "Glühweining",
      "Apfelschorling",
      "S-Bahning",
      "U-Bahning"
    ]
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "autoMemoryEnabled": false
}