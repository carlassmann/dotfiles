{
  "version": 1,
  "defaults": {
    "timeout": 900,
    "outputDir": "./agents/counselors/out",
    "readOnly": "bestEffort",
    "maxContextKb": 50,
    "maxParallel": 8
  },
  "tools": {
    "claude-opus-5": {
      "binary": "/Users/carlassmann/.local/bin/claude",
      "adapter": "claude",
      "readOnly": {
        "level": "enforced"
      },
      "extraFlags": [
        "--model",
        "claude-opus-5"
      ]
    },
    "claude-fable-5": {
      "binary": "/Users/carlassmann/.local/bin/claude",
      "adapter": "claude",
      "readOnly": {
        "level": "enforced"
      },
      "extraFlags": [
        "--model",
        "claude-fable-5"
      ]
    },
    "codex-gpt-5.6-sol": {
      "binary": "/opt/homebrew/bin/codex",
      "adapter": "codex",
      "readOnly": {
        "level": "enforced"
      },
      "extraFlags": [
        "-m",
        "gpt-5.6-sol"
      ]
    },
    "opencode-go-glm-5.2": {
      "binary": "/Users/carlassmann/.bun/bin/opencode",
      "readOnly": {
        "level": "bestEffort",
        "flags": [
          "--agent",
          "counselor",
          "--dangerously-skip-permissions"
        ]
      },
      "extraFlags": [
        "run",
        "-m",
        "opencode-go/glm-5.2"
      ],
      "custom": true
    },
    "opencode-go-kimi-k3": {
      "binary": "/Users/carlassmann/.bun/bin/opencode",
      "readOnly": {
        "level": "bestEffort",
        "flags": [
          "--agent",
          "counselor",
          "--dangerously-skip-permissions"
        ]
      },
      "extraFlags": [
        "run",
        "-m",
        "opencode-go/kimi-k3"
      ],
      "custom": true
    }
  },
  "groups": {
    "council": [
      "claude-opus-5",
      "claude-fable-5",
      "codex-gpt-5.6-sol",
      "opencode-go-glm-5.2",
      "opencode-go-kimi-k3"
    ],
    "review": [
      "claude-fable-5",
      "codex-gpt-5.6-sol",
      "opencode-go-kimi-k3"
    ]
  }
}
