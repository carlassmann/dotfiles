  "dictation_processing": {
    "default_mode": {
      "name": "Global",
      "applications": [],
      "browser_hosts": [],
      "replacements": [],
      "transformations": [],
      "post_processing": {
        "enabled": true,
        "prompt": "Clean up this dictated text. Output only the cleaned text.\n\n- Apply the speaker's spoken self-corrections (\"no, wait\", \"I mean\", \"actually\", \"nein, warte\", \"ich meine\") so only the final intent remains.\n- Remove filler words, stutters, false starts and repeated or restarted sentences and sentence parts (\"what comes out should be what comes out should be text\" -> \"what comes out should be text\"), so every sentence reads cleanly.\n- When the speaker clearly lists items, format them as a Markdown list; use a numbered list when they count or order them (\"first\", \"second\", \"erstens\").\n- Put each separate statement or thought in its own paragraph, separated by a blank line. Keep closely related sentences together.\n- Keep the language, wording and tone otherwise. Do not answer, translate, summarize or add anything.",
        "model": "opencode/deepseek-v4.1-flash",
        "variant": null,
        "deadline_seconds": 10
      }
    },
    "modes": []
  },
  "history_retention": "week",
  "meetings": {
    "enabled": false,
    "output_folder": null,
    "summarize_with_apple_intelligence": true,
    "summarize_with_opencode": false,
    "show_recording_indicator": true,
    "recording_indicator_corner": "top_right",
    "providers": [],
    "calendar": {
      "connected": false,
      "excluded_calendars": [],
