    },
    "retention": "forever"
  },
  "capture": {
    "enabled": true,
    "hotkey": {
      "keys": [
        {
          "code": 0,
          "label": "F9"
        }
      ]
    },
    "transcriber": "parakeet",
    "folder": null,
