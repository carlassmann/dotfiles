#!/usr/bin/env python3
"""Install a shared CLIProxyAPI host or connect a Claude/T3 Code client."""
import argparse
import hashlib
import io
import json
import os
from pathlib import Path
import platform
import secrets
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request
from urllib.parse import urlparse

VERSION = "8.1.0"
REPO = Path(__file__).resolve().parents[2]
STATE = Path.home() / ".cli-proxy-api"
PROFILE = STATE / "client.json"
BINARY = Path.home() / ".local/bin/cli-proxy-api"
CLAUDE = Path.home() / ".claude/settings.json"
T3 = Path.home() / ".t3/userdata/settings.json"
SOURCE = "dotfiles-claude-proxy"


def run(*args):
    return subprocess.check_output(args, text=True).strip()


def read_json(path):
    return json.loads(path.read_text()) if path.exists() else {}


def write_private(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, "wb" if isinstance(value, bytes) else "w") as stream:
            stream.write(value)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def save_json(path, value):
    write_private(path, json.dumps(value, indent=2) + "\n")


def backup(path):
    target = path.with_name(path.name + ".before-proxy")
    if path.exists() and not target.exists():
        write_private(target, path.read_text())


def fetch(url):
    with urllib.request.urlopen(url, timeout=60) as response:
        return response.read()


def install_binary():
    system = {"Linux": "linux", "Darwin": "darwin"}.get(platform.system())
    arch = {"x86_64": "amd64", "arm64": "aarch64", "aarch64": "aarch64"}.get(platform.machine())
    if not system or not arch:
        raise SystemExit("Unsupported host platform")
    asset = f"CLIProxyAPI_{VERSION}_{system}_{arch}.tar.gz"
    base = f"https://github.com/router-for-me/CLIProxyAPI/releases/download/v{VERSION}"
    archive = fetch(f"{base}/{asset}")
    checksums = fetch(f"{base}/checksums.txt").decode().splitlines()
    expected = next(line.split()[0] for line in checksums if line.split()[-1].lstrip("*") == asset)
    if hashlib.sha256(archive).hexdigest() != expected:
        raise SystemExit("Release checksum mismatch")
    with tarfile.open(fileobj=io.BytesIO(archive), mode="r:gz") as bundle:
        member = next(m for m in bundle.getmembers() if Path(m.name).name == "cli-proxy-api" and m.isfile())
        write_private(BINARY, bundle.extractfile(member).read())
        BINARY.chmod(0o755)
    print(f"Installed CLIProxyAPI {VERSION}")


def apply(template=None):
    profile = read_json(PROFILE)
    if not profile:
        return
    if profile.get("enabled") is False:
        if template:
            if CLAUDE.is_symlink():
                CLAUDE.unlink()
            save_json(CLAUDE, read_json(template))
        return
    backup(CLAUDE)
    settings = read_json(template or CLAUDE)
    connection_url = "http://127.0.0.1:8317" if profile.get("role") == "host" else profile["url"]
    ready = profile.get("role") != "host" or any((STATE / "accounts").glob("*.json"))
    if ready:
        settings.setdefault("env", {}).update({
            "ANTHROPIC_BASE_URL": connection_url,
            "ANTHROPIC_AUTH_TOKEN": profile["api_key"],
        })
    else:
        original = read_json(CLAUDE.with_name("settings.json.before-proxy"))
        for key in ("ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN"):
            settings.get("env", {}).pop(key, None)
            if key in original.get("env", {}):
                settings.setdefault("env", {})[key] = original["env"][key]
    # Replace the shared symlink: credentials must never enter tracked settings.
    if CLAUDE.is_symlink():
        CLAUDE.unlink()
    save_json(CLAUDE, settings)
    if T3.exists():
        backup(T3)
        settings = read_json(T3)
        sources = settings.setdefault("usageLimitSources", {})
        previous = sources.get(SOURCE, {})
        source = {"kind": "cliproxy", "label": "Shared Claude accounts", "url": connection_url, "enabled": True}
        # Preserve T3's secret-store reference when the same hub is reapplied.
        source["managementKey"] = previous.get("managementKey", profile["management_key"]) if previous.get("url") == connection_url else profile["management_key"]
        sources[SOURCE] = source
        save_json(T3, settings)
    print(f"Claude proxy: {connection_url}" if ready else "Claude keeps its existing connection until the first proxy account is logged in.")
    print("T3 Code: Settings > Providers > Usage providers.")


def host():
    if platform.system() != "Linux":
        raise SystemExit("Host service requires Linux; macOS supports client mode.")
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    STATE.chmod(0o700)
    profile = read_json(PROFILE)
    if profile and profile.get("role") != "host":
        raise SystemExit("Already configured as a client; disable it before hosting.")
    dns = json.loads(run("tailscale", "status", "--json"))["Self"]["DNSName"].rstrip(".")
    install_binary()
    profile = profile or {"api_key": secrets.token_urlsafe(32), "management_key": secrets.token_urlsafe(32)}
    profile.update(role="host", url=f"https://{dns}:8317", enabled=True)
    save_json(PROFILE, profile)
    config = read_json(REPO / "agents/proxy/config.json")
    config["access"]["api-keys"] = [profile["api_key"]]
    config["management"]["secret-key"] = profile["management_key"]
    config["oauth"]["auth-dir"] = str(STATE / "accounts")
    # Keep generated server IDs and management changes on repeated setup.
    if not (STATE / "config.yaml").exists():
        save_json(STATE / "config.yaml", config)
    if platform.system() == "Linux":
        units = Path.home() / ".config/systemd/user"
        units.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(REPO / "linux/systemd/cli-proxy-api.service", units / "cli-proxy-api.service")
        run("systemctl", "--user", "daemon-reload")
        run("systemctl", "--user", "enable", "--now", "cli-proxy-api.service")
    run("tailscale", "serve", "--bg", "--https=8317", "http://127.0.0.1:8317")
    apply()
    print(f"Dashboard: {profile['url']}/management.html")
    print("Add each account: agent-proxy login")


def client(path):
    incoming = read_json(Path(path).expanduser())
    url = urlparse(incoming.get("url", ""))
    if url.scheme != "https" or not url.hostname:
        raise SystemExit("Client profile requires an HTTPS URL")
    for key in ("api_key", "management_key"):
        if not incoming.get(key):
            raise SystemExit(f"Client profile missing {key}")
    current = read_json(PROFILE)
    if current.get("role") == "host":
        raise SystemExit("This machine hosts the proxy; do not replace its profile.")
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    STATE.chmod(0o700)
    save_json(PROFILE, {**{key: incoming[key] for key in ("url", "api_key", "management_key")}, "role": "client", "enabled": True})
    apply()


def status():
    profile = read_json(PROFILE)
    if not profile:
        raise SystemExit("No proxy profile. Run agent-proxy host or agent-proxy client PROFILE.")
    for endpoint, key in (("/v1/models", "api_key"), ("/v0/management/auth-files", "management_key")):
        request = urllib.request.Request(profile["url"] + endpoint, headers={"Authorization": "Bearer " + profile[key]})
        with urllib.request.urlopen(request, timeout=15) as response:
            data = json.load(response)
        print(f"{endpoint}: OK, {len(data.get('data', data.get('files', [])))} entries")
    print(f"Dashboard: {profile['url']}/management.html")


def disable():
    profile = read_json(PROFILE)
    if not profile:
        return
    settings = read_json(CLAUDE)
    original = read_json(CLAUDE.with_name("settings.json.before-proxy"))
    for key in ("ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN"):
        settings.get("env", {}).pop(key, None)
        if key in original.get("env", {}):
            settings.setdefault("env", {})[key] = original["env"][key]
    save_json(CLAUDE, settings)
    if T3.exists():
        settings = read_json(T3)
        settings.get("usageLimitSources", {}).pop(SOURCE, None)
        save_json(T3, settings)
    profile["enabled"] = False
    save_json(PROFILE, profile)
    print("Client disconnected. Host service and account tokens retained.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("host", help="Install Linux host service and share through Tailscale HTTPS")
    consumer = commands.add_parser("client", help="Import a private host profile on macOS/Linux")
    consumer.add_argument("profile")
    refresh = commands.add_parser("apply", help="Reapply local client settings after dotfiles updates")
    refresh.add_argument("--template", type=Path)
    commands.add_parser("status")
    commands.add_parser("disable", help="Disconnect this client without deleting accounts")
    commands.add_parser("login", help="Log a Claude account into this host")
    args = parser.parse_args()
    if args.command == "host":
        host()
    elif args.command == "client":
        client(args.profile)
    elif args.command == "apply":
        apply(args.template)
    elif args.command == "status":
        status()
    elif args.command == "disable":
        disable()
    elif args.command == "login":
        if read_json(PROFILE).get("role") != "host":
            raise SystemExit("Run login on the proxy host")
        subprocess.run([str(BINARY), "--config", str(STATE / "config.yaml"), "--claude-login"], check=True)
        profile = read_json(PROFILE)
        profile["enabled"] = True
        save_json(PROFILE, profile)
        apply()


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
