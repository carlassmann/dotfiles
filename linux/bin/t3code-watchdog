#!/usr/bin/env bash
# Restarts T3 Code when its server isn't answering on :3773, because the desktop
# app can hang before its backend starts (seen on Wayland, hence the X11 flag below)
# and nobody is at this headless box to notice. Run every minute by t3code-watchdog.timer.
set -euo pipefail

STARTUP_GRACE_SECONDS=120
AUTOSTART_UNIT='app-com.t3tools.T3Code@autostart.service'

AUTOSTART_ENTRY="$HOME/.config/autostart/com.t3tools.T3Code.desktop"

# The app may rewrite its autostart entry, and since t3code-bin 0.1.6 the
# /usr/bin/t3code wrapper ignores ~/.config/t3code-flags.conf, so the
# --ozone-platform=x11 workaround must live in Exec itself. Tracked copy:
# linux/autostart/com.t3tools.T3Code.desktop in the dotfiles.
if [[ -f "$AUTOSTART_ENTRY" ]] && ! grep -q '^Exec=/usr/bin/t3code --ozone-platform=x11' "$AUTOSTART_ENTRY"; then
  sed -i 's|^Exec=.*|Exec=/usr/bin/t3code --ozone-platform=x11 %U|' "$AUTOSTART_ENTRY"
  systemctl --user daemon-reload
fi

systemctl --user is-active --quiet graphical-session.target || exit 0
curl -sf -o /dev/null --max-time 5 http://127.0.0.1:3773/ && exit 0

oldest_pid=$(pgrep -o -x t3code || true)
if [[ -n "$oldest_pid" ]] && (( $(ps -o etimes= -p "$oldest_pid") < STARTUP_GRACE_SECONDS )); then
  exit 0
fi

echo "T3 Code server not answering on :3773; restarting it"
pkill -x t3code || true
sleep 3
pkill -9 -x t3code || true
systemctl --user reset-failed "$AUTOSTART_UNIT" 2>/dev/null || true
systemctl --user restart "$AUTOSTART_UNIT"
