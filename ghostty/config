# macOS only — on Omarchy, ~/.config/ghostty/config belongs to Omarchy and just
# includes shared.conf
config-file = shared.conf

theme = Github Dark Default

font-family = GeistMono Nerd Font
font-size = 15

maximize = true

shell-integration-features = no-cursor,ssh-terminfo,ssh-env

macos-option-as-alt = left
